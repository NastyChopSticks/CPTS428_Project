
{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:4b-instruct",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "qwen3:4b-instruct": {
          "name": "Qwen3 4B Instruct",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
